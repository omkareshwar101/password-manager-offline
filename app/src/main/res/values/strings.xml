    <!-- About -->
    <string name="about_title">About OfflineVault</string>
    <string name="about_tagline">A quiet place for passwords — entirely on your phone.</string>
    <string name="about_privacy_title">Zero-internet design</string>
    <string name="about_privacy_body">OfflineVault does not request INTERNET, ACCESS_NETWORK_STATE, Bluetooth, NFC, or camera permissions. There is no analytics SDK, ad SDK, Firebase, telemetry, or crash reporter. Airplane mode changes nothing.</string>
    <string name="about_security_title">How data is protected</string>
    <string name="about_security_body">Account data is stored in a SQLCipher-encrypted Room database. Sensitive fields are individually encrypted with AES-256-GCM using a key in the Android Keystore. App-private images use random UUID filenames. The app uses FLAG_SECURE on every screen.</string>
    <string name="about_permissions_title">Permissions</string>
    <string name="about_permissions_body">Only USE_BIOMETRIC and USE_FINGERPRINT are declared. The system file picker handles encrypted backup files without storage permissions. Photos are read once through the system picker; the camera app is launched externally without a camera permission.</string>
    <string name="about_recovery_title">Zero-knowledge recovery</string>
    <string name="about_recovery_body">There is no server, account, OTP, or email reset. Your PIN, two security answers, or an enrolled biometric on this device can unlock the vault. Losing all three means permanent loss.</string>
    <string name="about_clipboard_title">Clipboard &amp; screenshots</string>
    <string name="about_clipboard_body">Copied values auto-clear after your chosen timeout. Screenshots and screen recording are blocked by the operating system. The vault locks after backgrounding or inactivity.</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_built_with">Built with Kotlin, Jetpack Compose, Room + SQLCipher, Android Keystore, and BiometricPrompt.</string>
    <string name="about_no_links">This screen has no external links and uses no network.</string>

