    <!-- Privacy / onboarding -->
    <string name="privacy_title">Your secrets never leave this phone.</string>
    <string name="privacy_subtitle">OfflineVault is built to work completely offline. No account. No cloud. No tracking. No exceptions.</string>
    <string name="privacy_no_internet_title">No internet permission</string>
    <string name="privacy_no_internet_body">The app has no network permission at all, so it is physically unable to upload your data.</string>
    <string name="privacy_encrypted_title">Encrypted twice</string>
    <string name="privacy_encrypted_body">The database is locked with SQLCipher and every sensitive field is encrypted with AES-256-GCM.</string>
    <string name="privacy_keystore_title">Keys in Android Keystore</string>
    <string name="privacy_keystore_body">Encryption keys are generated in the Android Keystore and use hardware-backed security when available.</string>
    <string name="privacy_storage_title">Private storage only</string>
    <string name="privacy_storage_body">Your vault lives in app-private storage, hidden from file managers, USB access, and other apps.</string>
    <string name="privacy_recovery_title">You are the only recovery method</string>
    <string name="privacy_recovery_body">There is no email reset, OTP, or cloud backup. If you forget your PIN and security answers, the vault cannot be recovered.</string>
